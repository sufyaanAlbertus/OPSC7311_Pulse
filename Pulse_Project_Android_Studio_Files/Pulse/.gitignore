# Built application files
*.apk
# (The APK is published automatically to GitHub Releases by .github/workflows/build.yml)
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/
app/build/

# Local configuration file (contains SDK path, machine-specific — never commit this)
local.properties

# Android Studio / IntelliJ
.idea/
*.iml
*.ipr
*.iws
.navigation/
captures/
.externalNativeBuild/
.cxx/

# Log files
*.log

# OS-specific
.DS_Store
Thumbs.db

# Keystore files (never commit signing keys)
*.jks
*.keystore

# Firebase config: app/google-services.json is intentionally COMMITTED so the lecturer and
# GitHub Actions can build the app. It is not a secret — access is protected by Firestore
# security rules + Firebase Authentication. (Alternative: GOOGLE_SERVICES_JSON secret, see build.yml.)
